# ============================================================
# Campus Restaurant Website — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit your real `.env` file.
# ============================================================

# Server port
PORT=5000

# MySQL / TiDB connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
# Example (TiDB Serverless):
#   mysql://user:pass@gateway01.example.prod.aws.tidbcloud.com:4000/campus_restaurant?ssl-mode=REQUIRED
DB_URL=mysql://your_user:your_password@your_host:4000/your_database

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Email configuration (Gmail SMTP via Nodemailer)
# Get App Password: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="Campus Bites <your_email@example.com>"

# Set to true only when real Paystack integration is added (stays false for now)
PAYMENT_ENABLED=false

# Base URL of the frontend (used for CORS and email links)
FRONTEND_URL=http://localhost:5000
