{
  "name": "campus-restaurant-backend",
  "version": "1.0.0",
  "description": "Backend API for the Campus Restaurant Website (TiDB + MySQL2 + Express)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:watch": "node --watch server.js"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "src",
      ".env"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules",
      "scripts",
      "test"
    ],
    "delay": "300",
    "verbose": true
  },
  "keywords": [
    "express",
    "restaurant",
    "campus",
    "mysql",
    "tidb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
