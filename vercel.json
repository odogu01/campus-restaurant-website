{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/ping", "destination": "/api/index" },
    { "source": "/uploads/:path*", "destination": "/api/index" }
  ]
}
